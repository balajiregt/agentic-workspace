{
  "name": "agentic-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Context-aware workspace for local coding-agent experiments and microservice validation.",
  "scripts": {
    "setup:8gb": "AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/setup.sh",
    "agent:8gb": "AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/run-agent.sh",
    "setup:tool-agent": "AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/setup.sh",
    "agent:tool-agent": "AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/run-agent.sh",
    "agent:tool-agent:api": "AGENTIC_AGENT_SLICE=api AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/run-agent.sh",
    "agent:tool-agent:ui": "AGENTIC_AGENT_SLICE=ui AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/run-agent.sh",
    "setup:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long bash agent-system/local-agents/setup.sh",
    "agent:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long bash agent-system/local-agents/run-agent.sh",
    "agent:tool-agent-long:ui": "AGENTIC_AGENT_SLICE=ui AGENTIC_PROFILE=tool-agent-long bash agent-system/local-agents/run-agent.sh",
    "setup:tool-agent-25k": "AGENTIC_PROFILE=tool-agent-experimental-25k bash agent-system/local-agents/setup.sh",
    "agent:tool-agent-25k": "AGENTIC_PROFILE=tool-agent-experimental-25k bash agent-system/local-agents/run-agent.sh",
    "context:report": "python3 evidence/context/context_efficiency_report.py",
    "context:resolve": "python3 tooling/scripts/resolve_context.py",
    "context:ui:resolve": "python3 tooling/scripts/resolve_ui_context.py",
    "context:api-test": "python3 evidence/context/context_efficiency_report.py --task-profile api-test-change",
    "context:new-endpoint": "python3 evidence/context/context_efficiency_report.py --task-profile new-endpoint-change",
    "context:shared-qa": "python3 evidence/context/context_efficiency_report.py --task-profile shared-qa-utility-change",
    "context:walkthrough": "python3 evidence/context/context_efficiency_report.py --task-profile business-flow-walkthrough",
    "graph:build": "python3 tooling/scripts/build_test_graph.py",
    "graph:test": "python3 tooling/scripts/build_test_graph.py",
    "graph:serve": "python3 tooling/scripts/build_test_graph.py --serve",
    "dashboard:build": "python3 tooling/scripts/build_qa_dashboard.py",
    "dashboard:negative": "python3 tooling/scripts/build_qa_dashboard_negative.py",
    "dashboard:serve": "python3 tooling/scripts/build_qa_dashboard.py --serve",
    "graphify:setup": "python3 tooling/scripts/graphify_local.py setup",
    "graphify:build": "python3 tooling/scripts/graphify_local.py build",
    "graphify:serve": "python3 tooling/scripts/graphify_local.py serve",
    "graphs:serve": "python3 tooling/scripts/serve_graph_views.py",
    "graphs:docker:build": "docker compose -f tooling/docker/docker-compose.graphs.yml build",
    "graphs:docker:up": "docker compose -f tooling/docker/docker-compose.graphs.yml up",
    "ui:test": "npm --prefix qa/ui-automation/role-aware-mockserver run test:e2e",
    "ui:test:roles": "npm --prefix qa/ui-automation/role-aware-mockserver run test:roles",
    "ui:test:legacy-interception": "npm --prefix qa/ui-automation/role-aware-mockserver run test:legacy-interception",
    "metrics:8gb": "python3 agent-system/local-agents/token-metrics-dashboard.py --llama-url http://localhost:8080 --port 8764",
    "metrics:16gb": "python3 agent-system/local-agents/token-metrics-dashboard.py --llama-url http://localhost:8080 --port 8764",
    "metrics:custom": "python3 agent-system/local-agents/token-metrics-dashboard.py",
    "agent:doctor": "python3 agent-system/local-agents/check-tool-calls.py --base-url http://localhost:8080/v1 --model local-model",
    "models:profiles": "cat agent-system/local-agents/config/model-profiles.json",
    "models:tool-agent": "AGENTIC_PROFILE=tool-agent python3 agent-system/local-agents/render-pi-models.py --profile tool-agent --output /tmp/agentic-pi-models-tool-agent.json && cat /tmp/agentic-pi-models-tool-agent.json",
    "models:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long python3 agent-system/local-agents/render-pi-models.py --profile tool-agent-long --output /tmp/agentic-pi-models-tool-agent-long.json && cat /tmp/agentic-pi-models-tool-agent-long.json",
    "docs:models": "sed -n '1,220p' knowledge/docs/local-agent-runtime.md",
    "evidence:trial:collect": "node evidence/trials/trials.mjs collect",
    "evidence:trial:summary": "node evidence/trials/trials.mjs summary",
    "evidence:test": "node --test evidence/trials/*.test.mjs",
    "agents:dashboard": "npm --prefix products/agent-tools/agent-dashboard start",
    "agents:example": "npm --prefix products/agent-tools/agent-dashboard run example",
    "agents:status": "npm --prefix products/agent-tools/agent-dashboard run status",
    "agents:stop": "npm --prefix products/agent-tools/agent-dashboard run stop",
    "workspace:check": "python3 tooling/scripts/check_workspace.py",
    "workspace:test": "python3 -m unittest discover -s tooling/tests -p test_workspace_layout.py",
    "security:check": "python3 tooling/scripts/security_check.py",
    "security:staged": "node tooling/scripts/security-gate.mjs",
    "security:hooks": "node tooling/scripts/install-security-hook.mjs",
    "agents:map": "npm --prefix products/agent-tools/agent-dashboard run map",
    "agents:map:status": "npm --prefix products/agent-tools/agent-dashboard run map:status",
    "agents:map:stop": "npm --prefix products/agent-tools/agent-dashboard run map:stop",
    "context:test": "python3 -m unittest discover -s tooling/tests -p 'test_context*.py'",
    "agent:tool-agent:playwright": "AGENTIC_AGENT_SLICE=playwright-agent AGENTIC_PROFILE=tool-agent bash agent-system/local-agents/run-agent.sh"
  }
}
