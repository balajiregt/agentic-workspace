{
  "name": "agentic-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Context-aware workspace for local coding-agent experiments and microservice validation.",
  "scripts": {
    "setup:8gb": "AGENTIC_PROFILE=tool-agent bash local-agents/setup.sh",
    "agent:8gb": "AGENTIC_PROFILE=tool-agent bash local-agents/run-agent.sh",
    "setup:tool-agent": "AGENTIC_PROFILE=tool-agent bash local-agents/setup.sh",
    "agent:tool-agent": "AGENTIC_PROFILE=tool-agent bash local-agents/run-agent.sh",
    "agent:tool-agent:api": "AGENTIC_AGENT_SLICE=api AGENTIC_PROFILE=tool-agent bash local-agents/run-agent.sh",
    "agent:tool-agent:ui": "AGENTIC_AGENT_SLICE=ui AGENTIC_PROFILE=tool-agent bash local-agents/run-agent.sh",
    "setup:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long bash local-agents/setup.sh",
    "agent:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long bash local-agents/run-agent.sh",
    "agent:tool-agent-long:ui": "AGENTIC_AGENT_SLICE=ui AGENTIC_PROFILE=tool-agent-long bash local-agents/run-agent.sh",
    "setup:tool-agent-25k": "AGENTIC_PROFILE=tool-agent-experimental-25k bash local-agents/setup.sh",
    "agent:tool-agent-25k": "AGENTIC_PROFILE=tool-agent-experimental-25k bash local-agents/run-agent.sh",
    "context:report": "python3 scripts/context_efficiency_report.py",
    "context:resolve": "python3 scripts/resolve_context.py",
    "context:ui:resolve": "python3 scripts/resolve_ui_context.py",
    "context:api-test": "python3 scripts/context_efficiency_report.py --task-profile api-test-change",
    "context:new-endpoint": "python3 scripts/context_efficiency_report.py --task-profile new-endpoint-change",
    "context:shared-qa": "python3 scripts/context_efficiency_report.py --task-profile shared-qa-utility-change",
    "context:walkthrough": "python3 scripts/context_efficiency_report.py --task-profile business-flow-walkthrough",
    "graph:build": "python3 scripts/build_test_graph.py",
    "graph:test": "python3 scripts/build_test_graph.py",
    "graph:serve": "python3 scripts/build_test_graph.py --serve",
    "dashboard:build": "python3 scripts/build_qa_dashboard.py",
    "dashboard:negative": "python3 scripts/build_qa_dashboard_negative.py",
    "dashboard:serve": "python3 scripts/build_qa_dashboard.py --serve",
    "graphify:setup": "python3 scripts/graphify_local.py setup",
    "graphify:build": "python3 scripts/graphify_local.py build",
    "graphify:serve": "python3 scripts/graphify_local.py serve",
    "graphs:serve": "python3 scripts/serve_graph_views.py",
    "graphs:docker:build": "docker compose -f docker-compose.graphs.yml build",
    "graphs:docker:up": "docker compose -f docker-compose.graphs.yml up",
    "viewer:build": "npm --prefix projects/qa-dashboard-viewer run build",
    "viewer:dev": "npm --prefix projects/qa-dashboard-viewer run dev",
    "viewer:preview": "npm --prefix projects/qa-dashboard-viewer run preview",
    "ui:test": "npm --prefix projects/ui-automation/role-aware-mockserver run test:e2e",
    "ui:test:roles": "npm --prefix projects/ui-automation/role-aware-mockserver run test:roles",
    "ui:test:legacy-interception": "npm --prefix projects/ui-automation/role-aware-mockserver run test:legacy-interception",
    "metrics:8gb": "python3 local-agents/token-metrics-dashboard.py --llama-url http://localhost:8080 --port 8764",
    "metrics:16gb": "python3 local-agents/token-metrics-dashboard.py --llama-url http://localhost:8080 --port 8764",
    "metrics:custom": "python3 local-agents/token-metrics-dashboard.py",
    "agent:doctor": "python3 local-agents/check-tool-calls.py --base-url http://localhost:8080/v1 --model local-model",
    "models:profiles": "cat local-agents/config/model-profiles.json",
    "models:tool-agent": "AGENTIC_PROFILE=tool-agent python3 local-agents/render-pi-models.py --profile tool-agent --output /tmp/agentic-pi-models-tool-agent.json && cat /tmp/agentic-pi-models-tool-agent.json",
    "models:tool-agent-long": "AGENTIC_PROFILE=tool-agent-long python3 local-agents/render-pi-models.py --profile tool-agent-long --output /tmp/agentic-pi-models-tool-agent-long.json && cat /tmp/agentic-pi-models-tool-agent-long.json",
    "docs:models": "sed -n '1,220p' docs/local-agent-runtime.md",
    "benchmark:collect": "node benchmarks/trials.mjs collect",
    "benchmark:summary": "node benchmarks/trials.mjs summary",
    "benchmark:test": "node --test benchmarks/*.test.mjs",
    "benchmark": "python3 benchmarks/dashboard/run.py",
    "benchmark:publish": "python3 benchmarks/dashboard/publish.py",
    "postbenchmark:collect": "python3 benchmarks/dashboard/publish.py --refresh-trials",
    "benchmark:trials": "python3 benchmarks/controlled-trials.py",
    "benchmark:trials:local": "python3 benchmarks/controlled-trials.py --local"
  }
}
