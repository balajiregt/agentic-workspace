FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir PyYAML graphifyy==0.9.33

COPY . /workspace

ENV GRAPHIFY_BIN=/usr/local/bin/graphify

EXPOSE 8765 8766 8767

CMD ["python3", "scripts/serve_graph_views.py", "--host", "0.0.0.0"]
