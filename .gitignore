.DS_Store
.idea/
*.iml
.netlify/
projects/**/.netlify/

# Local reference symlink.
context-starter

# Local runtime downloads/builds stay out of Git.
local-agents/models/
local-agents/cache/
local-agents/.cache/
local-agents/llama.cpp/
local-agents/node_modules/
local-agents/*.log

# Generated build/test artifacts.
target/
build/
artifacts/
node_modules/
__pycache__/
*.py[cod]
projects/ui-automation/**/playwright-report/
projects/ui-automation/**/test-results/
graphify-out/
*.tar

# Machine-local resolved context generated from current task and service metadata.
contexts/current/resolved-context.yml
contexts/current/resolved-ui-context.yml

# Keep the Medium draft local; publish the repo as the reference artifact.
docs/medium-blog-agentic-workspace.md
docs/blog-agentic-workspace-v2.md

# Older standalone PoC repo retained locally, not part of this workspace commit.
projects/copilot-sprint-metrics-starter/

benchmark-results/

# Private benchmark execution and publication state
benchmark-results/
benchmarks/dashboard/__pycache__/

# Security tooling and generated runtime state
artifacts/
node_modules/
.next/
dist/
target/
*.tsbuildinfo
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Reviewed local security archives are source inputs, not build output.
!**/scripts/security/*.tgz
