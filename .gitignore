.DS_Store
.idea/
*.iml
.netlify/
projects/**/.netlify/

# Local reference symlink.
agent-system/context-starter

# Local runtime downloads/builds stay out of Git.
agent-system/local-agents/models/
agent-system/local-agents/cache/
agent-system/local-agents/.cache/
agent-system/local-agents/llama.cpp/
agent-system/local-agents/node_modules/
agent-system/local-agents/*.log

# Generated build/test artifacts.
target/
build/
artifacts/
node_modules/
__pycache__/
*.py[cod]
qa-projects/ui-automation/**/playwright-report/
qa-projects/ui-automation/**/test-results/
artifacts/graphify-out/
*.tar

# Keep the Medium draft local; publish the repo as the reference artifact.
knowledge/docs/medium-blog-agentic-workspace.md
knowledge/docs/blog-agentic-workspace-v2.md

# Older standalone PoC repo retained locally, not part of this workspace commit.
projects/copilot-sprint-metrics-starter/

benchmark-results/
evaluation/benchmarks/dashboard/__pycache__/

# The single canonical UI project retains its independent Git history.
/qa-projects/ui-automation/role-aware-mockserver/

# Project-owned task inputs and generated context. Keep only sanitised examples.
projects/microservices/contexts/tasks/*
!projects/microservices/contexts/tasks/ABC-123.yml
**/contexts/.resolved/
**/contexts/tasks/.resolved/

# Independent nested Git repositories keep their own history.
/qa-projects/Playwright Agentic Framework/
/qa-projects/playwright_pom_fixtures_modular_framework_template/
/projects/kafka-test-project/
/projects/framework-benchmark-dashboard/
